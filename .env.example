# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o

# ── AWS Bedrock (alternative) ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Crawler ───────────────────────────────────────────────────────────────────
CRAWLER_HEADLESS=true          # false to see browser during dev
CRAWLER_TIMEOUT_MS=30000       # 30 seconds per page
CRAWLER_MAX_ELEMENTS=200       # max elements to extract per page

# ── Generator ─────────────────────────────────────────────────────────────────
DEFAULT_FRAMEWORK=playwright   # playwright | selenium | pytest_api
OUTPUT_DIR=./outputs

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=                       # optional — secure the API

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=test-forge

# ── Target application ────────────────────────────────────────────────────────
DEFAULT_BASE_URL=https://www.saucedemo.com
APP_USERNAME=standard_user     # for auth agent
APP_PASSWORD=secret_sauce      # for auth agent
